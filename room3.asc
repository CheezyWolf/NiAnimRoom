// room script file

function room_FirstLoad()
{
 RemoveWalkableArea(3);
oPond.SetView(6);
oPond.Animate(0, 12, eRepeat, eNoBlock);
}
function oBalloon_Interact(Object *theObject, CursorMode mode)
{
WalkToObjectAndJumpUp(theObject, 50, iBalloon);
}
//Dig Dirt

function oDigDirt_Interact(Object *theObject, CursorMode mode)
{
player.Walk(theObject.X+124, theObject.Y-20, eBlock, eWalkableAreas);
player.ChangeView(15);
player.Animate(0, 6, eOnce, eBlock);
player.ChangeView(4);
oDigDirt.SetView(10);
oDigDirt.Animate(0, 2, eOnce, eNoBlock);
oDigDirt.Clickable=false;
}
function oDigDirt2_Interact(Object *theObject, CursorMode mode)
{
player.Walk(394, 679, eBlock, eWalkableAreas);
player.ChangeView(15);
player.Animate(0, 6, eOnce, eBlock);
player.ChangeView(4);
oDigDirt2.SetView(10);
oDigDirt2.Animate(0, 3, eOnce, eBlock);
oDigDirt2.Clickable=false;
}

function oDigDirt3_Interact(Object *theObject, CursorMode mode)
{
player.Walk(547, 673, eBlock, eWalkableAreas);
player.ChangeView(15);
player.Animate(0, 6, eOnce, eBlock);
player.ChangeView(4);
oDigDirt3.SetView(10);
oDigDirt3.Animate(0, 3, eOnce, eBlock, eForwards);
oKey1.Visible=true;
oDigDirt3.Clickable=false;
}

//Change to climb animation
function region1_WalksOnto(Region *theRegion)
{
player.LockView(11);
}

function region1_WalksOff(Region *theRegion)
{
player.ChangeView(4);
}

//Pick up Key
function oObject0_Interact(Object *theObject, CursorMode mode)
{
WalkToObjectAndPickUp(theObject);
player.AddInventory(iKey1);
}
//Uncurl vines
function oUncurlVine_Interact(Object *theObject, CursorMode mode)
{
oUncurlVine.SetView(14);
oUncurlVine.Animate(0, 5, eOnce, eBlock, eForwards);
RestoreWalkableArea(3);
}
//Interact with flower
function oFlower_Interact(Object *theObject, CursorMode mode)
{
player.Walk(468, 284, eBlock, eWalkableAreas);
oFlower.SetView(5);
oFlower.Animate(0, 6, eOnce, eBlock);
player.Say("Uh Oh");
}
