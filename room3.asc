// room script file

function room_FirstLoad()
{
oFlower.SetView(5);
oFlower.Animate(0, 5, eRepeat, eNoBlock);
oPond.SetView(6);
oPond.Animate(0, 12, eRepeat, eNoBlock);
}
function oBalloon_Interact(Object *theObject, CursorMode mode)
{
WalkToObjectAndJumpUp(theObject, 50, iBalloon);
}
//Dig Dirt
function oDigDirt_Interact(Object *obj, CursorMode mode)
{
 oDigDirt_Interact(oDigDirt, eModeInteract);
 oDigDirt.SetView(10);
 oDigDirt.Animate(0, 3, eOnce, eNoBlock);
}
